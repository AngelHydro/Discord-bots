DISCORD_TOKEN=colle_ton_token_ici
VIEWER_PASSWORD=choisis_un_mot_de_passe

# --- Notifications sur le telephone (facultatif, appli ntfy) ---
# Nom secret du canal : n'importe qui le connaissant peut lire les notifications.
# Garde un nom long et aleatoire, par exemple :
# NTFY_TOPIC=discord-viewer-tape-ici-une-suite-au-hasard-8f3kq2
NTFY_TOPIC=
# Seulement ces salons (noms ou IDs, separes par des virgules). Vide = tous.
NOTIFY_CHANNELS=
# Seulement les messages contenant un de ces mots. Vide = tous.
NOTIFY_KEYWORDS=
